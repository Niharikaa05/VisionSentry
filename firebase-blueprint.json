{
  "entities": {
    "Alert": {
      "title": "Alert",
      "description": "A security alert generated by the AI vision system.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique alert ID" },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the alert was generated" },
        "type": { "type": "string", "description": "Type of alert (e.g., Armed Personnel)" },
        "description": { "type": "string", "description": "Detailed description of the alert" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"], "description": "Alert severity level" },
        "status": { "type": "string", "enum": ["active", "resolved", "dismissed"], "description": "Current status of the alert" }
      },
      "required": ["id", "timestamp", "type", "description", "severity", "status"]
    },
    "SystemLog": {
      "title": "SystemLog",
      "description": "A log entry for system events.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique log ID" },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the log was created" },
        "event": { "type": "string", "description": "The event description" },
        "type": { "type": "string", "enum": ["info", "warning", "error", "success"], "description": "Log entry type" }
      },
      "required": ["id", "timestamp", "event", "type"]
    },
    "Personnel": {
      "title": "Personnel",
      "description": "A personnel record in the database.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique personnel ID" },
        "name": { "type": "string", "description": "Full name of the person" },
        "rank": { "type": "string", "description": "Rank or title" },
        "clearance": { "type": "string", "enum": ["LEVEL_1", "LEVEL_2", "LEVEL_3", "LEVEL_4", "LEVEL_5"], "description": "Security clearance level" },
        "status": { "type": "string", "enum": ["ACTIVE", "OFF_DUTY", "DEPLOYED", "INACTIVE"], "description": "Current status" },
        "lastSeen": { "type": "string", "description": "Last known location or timestamp" },
        "photo": { "type": "string", "description": "URL to the profile photo" }
      },
      "required": ["id", "name", "rank", "clearance", "status"]
    }
  },
  "firestore": {
    "/alerts/{alertId}": {
      "schema": "Alert",
      "description": "Collection of security alerts."
    },
    "/logs/{logId}": {
      "schema": "SystemLog",
      "description": "Collection of system logs."
    },
    "/personnel/{personnelId}": {
      "schema": "Personnel",
      "description": "Collection of personnel records."
    }
  }
}
